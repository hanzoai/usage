{
  "name": "@hanzo/usage",
  "version": "0.1.15",
  "description": "Track AI provider usage, rate limits, and spend across every Hanzo surface. Headless provider engine + full provider catalog.",
  "license": "MIT",
  "author": "Hanzo AI Inc",
  "homepage": "https://github.com/hanzoai/usage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/usage.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./connected": {
      "types": "./dist/connected.d.ts",
      "default": "./dist/connected.js"
    },
    "./node": {
      "types": "./dist/hosts/node.d.ts",
      "default": "./dist/hosts/node.js"
    },
    "./tauri": {
      "types": "./dist/hosts/tauri.d.ts",
      "default": "./dist/hosts/tauri.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.components.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run check"
  },
  "peerDependencies": {
    "@hanzo/gui": ">=8.3.0",
    "@hanzogui/lucide-icons-2": ">=8.3.1",
    "react": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "@hanzo/gui": {
      "optional": true
    },
    "@hanzogui/lucide-icons-2": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hanzo/gui": "8.3.1",
    "@hanzogui/config": "8.3.1",
    "@hanzogui/core": "8.3.1",
    "@hanzogui/lucide-icons-2": "8.3.1",
    "@hanzogui/web": "8.3.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
